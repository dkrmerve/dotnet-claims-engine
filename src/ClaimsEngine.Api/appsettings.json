{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=claims;Username=claims;Password=claims;Minimum Pool Size=2;Maximum Pool Size=50;Timeout=15;Command Timeout=30"
  },
  "Rules": {
    "FilingWindowDays": 30,
    "FrequentClaimantThreshold": 3,
    "FrequentClaimantWindowDays": 365,
    "HighValueShareOfLimit": 0.80,
    "ReviewSlaDays": 14,
    "AdjusterApprovalLimit": 5000,
    "SeniorAdjusterApprovalLimit": 50000
  },
  "Idempotency": {
    "TtlHours": 24,
    "SweepIntervalMinutes": 60
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 10
  },
  "Auth": {
    "Authority": null,
    "Audience": null,
    "DevIssuer": {
      "Enabled": false,
      "SigningKey": null,
      "Issuer": "claims-engine-dev",
      "Audience": "claims-engine",
      "TokenLifetimeMinutes": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
