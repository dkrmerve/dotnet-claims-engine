# Copy to .env and adjust. Every value has a local-development default in docker-compose.yml;
# nothing here is a production secret.

# PostgreSQL (compose service "postgres")
POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_PORT=5432

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Authentication. Dev issuer = symmetric key + POST /auth/token, local demo only.
# For a real deployment set Auth__Authority / Auth__Audience instead and leave the dev issuer off.
AUTH_DEV_ISSUER_ENABLED=true
AUTH_DEV_SIGNING_KEY=local-demo-only-signing-key-change-me-0123456789

# Idempotency-Key retention
IDEMPOTENCY_TTL_HOURS=24

# Fixed-window rate limit on write endpoints, per client address
RATE_LIMIT_PERMITS=60
RATE_LIMIT_WINDOW_SECONDS=10

# Business rules
RULES_FILING_WINDOW_DAYS=30
RULES_REVIEW_SLA_DAYS=14
RULES_FREQUENT_CLAIMANT_THRESHOLD=3
RULES_HIGH_VALUE_SHARE=0.80
RULES_ADJUSTER_LIMIT=5000
RULES_SENIOR_ADJUSTER_LIMIT=50000
